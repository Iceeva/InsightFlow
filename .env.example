# ═══════════════════════════════════════════════════
# InsightFlow - Environment Variables
# ═══════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────
# Recommended for most uses
DATABASE_URL=

# ─── Redis ────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=...
JWT_SECRET=...
JWT_REFRESH_SECRET=...

# ─── OAuth ────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Email (SMTP) ────────────────────────────────
SMTP_HOST=""
SMTP_PORT=
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# ─── Slack Notifications ─────────────────────────
SLACK_WEBHOOK_URL=""

# ─── Push Notifications ──────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ─── OpenTelemetry ───────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="insightflow"

# ─── App ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
WS_PORT=3001
NODE_ENV=development
