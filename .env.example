OTEL_SERVICE_NAME="insightflow"

# ─── App ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
WS_PORT=3001
NODE_ENV=development
